# Copier en .env :  cp .env.example .env
COMPOSE_PROJECT_NAME=llm-stack

POSTGRES_DB=llmapp
POSTGRES_USER=llmapp

# Modèle servi par llama.cpp (fichier GGUF téléchargé une seule fois dans le volume llm_models)
LLM_MODEL=qwen2.5-0.5b-instruct
MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf
LLM_THREADS=4
LLM_CPUS=2.0

WEB_PORT=8080
LOG_LEVEL=INFO
APP_VERSION=dev

# Pour la sauvegarde (profil backup) sous Linux/macOS : id -u / id -g
HOST_UID=1000
HOST_GID=1000

# Ports publiés en dev (compose.override.yml) : à changer si un port est déjà utilisé sur votre machine
API_DEV_PORT=8000
DB_DEV_PORT=5432
LLM_DEV_PORT=8081
